{
  "version": "1.0.0",
  "layout_name": "admin_analytics_dashboard",
  "permissions": [
    "glitter-analytics.dashboard.view"
  ],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:glitter-analytics.admin.dashboard.title",
    "description": "$t:glitter-analytics.admin.dashboard.description"
  },
  "data_sources": [
    {
      "id": "analyticsDashboard",
      "type": "api",
      "endpoint": "/api/modules/glitter-analytics/admin/dashboard",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "refetchOnMount": true,
      "fallback": {
        "data": {
          "timezone": "",
          "summary": {
            "visitors_today": 0,
            "sessions_today": 0,
            "pageviews_today": 0,
            "pageviews_7d": 0
          },
          "trend": [],
          "popular_paths": [],
          "referrers": [],
          "recent_visits": []
        }
      }
    },
    {
      "id": "analyticsDashboardRealtime",
      "type": "websocket",
      "channel": "module.glitter-analytics.dashboard",
      "event": "dashboard.updated",
      "channel_type": "private",
      "target_source": "analyticsDashboard"
    }
  ],
  "slots": {
    "content": [
      {
        "id": "dashboard_content",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "admin-page-content-fluid space-y-4"
        },
        "children": [
          {
            "type": "composite",
            "name": "PageHeader",
            "props": {
              "title": "$t:glitter-analytics.admin.dashboard.title",
              "description": "$t:glitter-analytics.admin.dashboard.description"
            }
          },
          {
            "id": "dashboard_error",
            "type": "basic",
            "name": "P",
            "if": "{{analyticsDashboard?.error}}",
            "text": "$t:glitter-analytics.admin.common.load_error",
            "props": {
              "className": "alert-error"
            }
          },
          {
            "id": "summary_cards",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4"
            },
            "children": [
              {
                "id": "visitors_today",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "admin-card"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "P",
                    "text": "$t:glitter-analytics.admin.dashboard.cards.visitors_today",
                    "props": {
                      "className": "text-sm text-gray-500 dark:text-gray-400"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "H3",
                    "text": "{{analyticsDashboard?.data?.summary?.visitors_today ?? 0}}",
                    "props": {
                      "className": "text-2xl font-bold text-gray-900 dark:text-white"
                    }
                  }
                ]
              },
              {
                "id": "sessions_today",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "admin-card"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "P",
                    "text": "$t:glitter-analytics.admin.dashboard.cards.sessions_today",
                    "props": {
                      "className": "text-sm text-gray-500 dark:text-gray-400"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "H3",
                    "text": "{{analyticsDashboard?.data?.summary?.sessions_today ?? 0}}",
                    "props": {
                      "className": "text-2xl font-bold text-gray-900 dark:text-white"
                    }
                  }
                ]
              },
              {
                "id": "pageviews_today",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "admin-card"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "P",
                    "text": "$t:glitter-analytics.admin.dashboard.cards.pageviews_today",
                    "props": {
                      "className": "text-sm text-gray-500 dark:text-gray-400"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "H3",
                    "text": "{{analyticsDashboard?.data?.summary?.pageviews_today ?? 0}}",
                    "props": {
                      "className": "text-2xl font-bold text-gray-900 dark:text-white"
                    }
                  }
                ]
              },
              {
                "id": "pageviews_7d",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "admin-card"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "P",
                    "text": "$t:glitter-analytics.admin.dashboard.cards.pageviews_7d",
                    "props": {
                      "className": "text-sm text-gray-500 dark:text-gray-400"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "H3",
                    "text": "{{analyticsDashboard?.data?.summary?.pageviews_7d ?? 0}}",
                    "props": {
                      "className": "text-2xl font-bold text-gray-900 dark:text-white"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "trend",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "admin-card overflow-x-auto"
            },
            "children": [
              {
                "type": "basic",
                "name": "H3",
                "text": "$t:glitter-analytics.admin.dashboard.trend.title",
                "props": {
                  "className": "font-semibold mb-3"
                }
              },
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "min-w-[36rem] grid grid-cols-7 gap-3 items-end"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Div",
                    "iteration": {
                      "source": "{{analyticsDashboard?.data?.trend || []}}",
                      "item_var": "day"
                    },
                    "props": {
                      "className": "flex flex-col gap-1 text-center"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "{{day.pageviews}}",
                        "props": {
                          "className": "font-semibold"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "h-40 flex items-end justify-center gap-1 border-b border-gray-300 dark:border-gray-600",
                          "role": "img"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "w-5 bg-cyan-500 dark:bg-cyan-400 rounded-t",
                              "style": "{{({ height: Math.max(4, Math.round((day.visitors / Math.max(1, ...(analyticsDashboard?.data?.trend || []).map(item => Math.max(item.visitors, item.pageviews)))) * 100)) + '%' })}}",
                              "title": "{{$t('glitter-analytics.admin.dashboard.trend.visitors_tooltip', { date: day.date, count: day.visitors })}}",
                              "aria-label": "{{$t('glitter-analytics.admin.dashboard.trend.visitors_tooltip', { date: day.date, count: day.visitors })}}",
                              "tabIndex": 0
                            }
                          },
                          {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "w-5 bg-blue-600 dark:bg-blue-400 rounded-t",
                              "style": "{{({ height: Math.max(4, Math.round((day.pageviews / Math.max(1, ...(analyticsDashboard?.data?.trend || []).map(item => Math.max(item.visitors, item.pageviews)))) * 100)) + '%' })}}",
                              "title": "{{$t('glitter-analytics.admin.dashboard.trend.pageviews_tooltip', { date: day.date, count: day.pageviews })}}",
                              "aria-label": "{{$t('glitter-analytics.admin.dashboard.trend.pageviews_tooltip', { date: day.date, count: day.pageviews })}}",
                              "tabIndex": 0
                            }
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "{{day.date}}",
                        "props": {
                          "className": "text-xs"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "{{$t('glitter-analytics.admin.dashboard.trend.visitors_value', { count: day.visitors })}}",
                        "props": {
                          "className": "text-xs text-gray-500"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "props": { "className": "flex flex-wrap gap-4 mt-4 text-sm", "aria-label": "$t:glitter-analytics.admin.dashboard.trend.legend_label" },
                "children": [
                  { "type": "basic", "name": "Span", "props": { "className": "inline-flex items-center gap-2" }, "children": [
                    { "type": "basic", "name": "Span", "props": { "className": "w-3 h-3 rounded-sm bg-cyan-500 dark:bg-cyan-400", "aria-hidden": true } },
                    { "type": "basic", "name": "Span", "text": "$t:glitter-analytics.admin.dashboard.trend.visitors" }
                  ] },
                  { "type": "basic", "name": "Span", "props": { "className": "inline-flex items-center gap-2" }, "children": [
                    { "type": "basic", "name": "Span", "props": { "className": "w-3 h-3 rounded-sm bg-blue-600 dark:bg-blue-400", "aria-hidden": true } },
                    { "type": "basic", "name": "Span", "text": "$t:glitter-analytics.admin.dashboard.trend.pageviews" }
                  ] }
                ]
              }
            ]
          },
          {
            "id": "rankings",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "grid grid-cols-1 xl:grid-cols-2 gap-4"
            },
            "children": [
              {
                "id": "popular_paths",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "admin-card min-w-0"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H3",
                    "text": "$t:glitter-analytics.admin.dashboard.popular.title",
                    "props": {
                      "className": "font-semibold mb-3"
                    }
                  },
                  { "type": "composite", "name": "EmptyState", "if": "{{(analyticsDashboard?.data?.popular_paths || []).length === 0}}", "props": { "iconName": "chart-bar", "title": "$t:glitter-analytics.admin.dashboard.popular.empty_title", "description": "$t:glitter-analytics.admin.dashboard.popular.empty", "className": "py-8" } },
                  {
                    "type": "basic",
                    "name": "Div",
                    "iteration": {
                      "source": "{{analyticsDashboard?.data?.popular_paths || []}}",
                      "item_var": "item"
                    },
                    "props": {
                      "className": "py-2 border-b dark:border-gray-700 space-y-2",
                      "role": "group",
                      "aria-label": "{{$t('glitter-analytics.admin.dashboard.popular.item_label', { path: item.path, count: item.pageviews })}}"
                    },
                    "children": [
                      { "type": "basic", "name": "Div", "props": { "className": "flex justify-between gap-3" }, "children": [
                        { "type": "basic", "name": "Span", "text": "{{item.path}}", "props": { "className": "min-w-0 break-all text-sm" } },
                        { "type": "basic", "name": "Span", "text": "{{item.pageviews}}", "props": { "className": "font-semibold shrink-0" } }
                      ] },
                      { "type": "basic", "name": "Div", "props": { "className": "h-1.5 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden", "role": "progressbar", "aria-valuemin": 0, "aria-valuemax": "{{Math.max(0, ...(analyticsDashboard?.data?.popular_paths || []).map(path => path.pageviews))}}", "aria-valuenow": "{{item.pageviews}}" }, "children": [
                        { "type": "basic", "name": "Div", "props": { "className": "h-full rounded-full bg-blue-600 dark:bg-blue-400", "style": "{{({ width: Math.max(0, Math.round((item.pageviews / Math.max(1, ...(analyticsDashboard?.data?.popular_paths || []).map(path => path.pageviews))) * 100)) + '%' })}}" } }
                      ] }
                    ]
                  }
                ]
              },
              {
                "id": "referrers",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "admin-card min-w-0"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H3",
                    "text": "$t:glitter-analytics.admin.dashboard.referrers.title",
                    "props": {
                      "className": "font-semibold mb-3"
                    }
                  },
                  { "type": "composite", "name": "EmptyState", "if": "{{(analyticsDashboard?.data?.referrers || []).length === 0}}", "props": { "iconName": "link", "title": "$t:glitter-analytics.admin.dashboard.referrers.empty_title", "description": "$t:glitter-analytics.admin.dashboard.referrers.empty", "className": "py-8" } },
                  {
                    "type": "basic",
                    "name": "Div",
                    "iteration": {
                      "source": "{{analyticsDashboard?.data?.referrers || []}}",
                      "item_var": "item"
                    },
                    "props": {
                      "className": "flex justify-between gap-3 py-2 border-b dark:border-gray-700"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "{{item.host}}",
                        "props": {
                          "className": "break-all"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "{{item.pageviews}}",
                        "props": {
                          "className": "font-semibold"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "recent",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "admin-card overflow-x-auto"
            },
            "children": [
              {
                "type": "basic",
                "name": "H3",
                "text": "$t:glitter-analytics.admin.dashboard.recent.title"
              },
              { "type": "basic", "name": "Div", "if": "{{(analyticsDashboard?.data?.recent_visits || []).length > 0}}", "props": { "className": "hidden md:grid md:grid-cols-4 gap-2 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400 border-b dark:border-gray-700" }, "children": [
                { "type": "basic", "name": "Span", "text": "$t:glitter-analytics.admin.dashboard.recent.columns.occurred_at" },
                { "type": "basic", "name": "Span", "text": "$t:glitter-analytics.admin.dashboard.recent.columns.path" },
                { "type": "basic", "name": "Span", "text": "$t:glitter-analytics.admin.dashboard.recent.columns.source" },
                { "type": "basic", "name": "Span", "text": "$t:glitter-analytics.admin.dashboard.recent.columns.member" }
              ] },
              { "type": "composite", "name": "EmptyState", "if": "{{(analyticsDashboard?.data?.recent_visits || []).length === 0}}", "props": { "iconName": "history", "title": "$t:glitter-analytics.admin.dashboard.recent.empty_title", "description": "$t:glitter-analytics.admin.dashboard.recent.empty", "className": "py-8" } },
              {
                "type": "basic",
                "name": "Div",
                "iteration": {
                  "source": "{{analyticsDashboard?.data?.recent_visits || []}}",
                  "item_var": "visit"
                },
                "props": {
                  "className": "grid grid-cols-1 md:grid-cols-4 gap-2 py-2 border-b dark:border-gray-700"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "{{visit.occurred_at}}"
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "{{visit.path}}",
                    "props": {
                      "className": "font-mono break-all"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "{{visit.source === 'initial' ? '$t:glitter-analytics.source.initial' : '$t:glitter-analytics.source.spa'}}"
                  },
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "{{visit.member?.is_member ? (visit.member?.name || '$t:glitter-analytics.member.member') : '$t:glitter-analytics.member.guest'}}"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
